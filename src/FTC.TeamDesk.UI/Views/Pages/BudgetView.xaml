<UserControl x:Class="FTC.TeamDesk.UI.Views.Pages.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FTC.TeamDesk.UI.Localization"
             xmlns:ctl="clr-namespace:FTC.TeamDesk.UI.Controls"
             xmlns:h="clr-namespace:FTC.TeamDesk.UI.Helpers"
             xmlns:ui="clr-namespace:FTC.TeamDesk.UI"
             xmlns:enums="clr-namespace:FTC.TeamDesk.Core.Enums;assembly=FTC.TeamDesk.Core">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="32,28,32,32">
      <Grid Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="{loc:Loc Nav.Budget}" Style="{StaticResource TextTitle}" />
          <TextBlock Text="{loc:Loc Budget.Subtitle}" Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Command="{Binding EditBudgetCommand}" Content="{loc:Loc Budget.Settings}" />
          <Button Command="{Binding ManageCategoriesCommand}" Content="{loc:Loc Budget.Categories}" Margin="8,0,0,0" />
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Content="{loc:Loc Budget.New}" Margin="8,0,0,0" ToolTip="Ctrl+N" />
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource Panel}" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" Margin="0,0,0,16" Padding="16,12"
              Visibility="{Binding HasShortfall, Converter={StaticResource BoolToVis}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding ShortfallText}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
        <ItemsControl ItemsSource="{Binding Figures}" Margin="0,0,-1,-1">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1" Padding="20,16">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" Style="{StaticResource TextCaption}" />
                  <TextBlock Text="{Binding Value}" Margin="0,4,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource TextKpi}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                          <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Panel}" Padding="0">
          <StackPanel>
            <Grid Margin="20,18,20,12">
              <TextBlock Text="{loc:Loc Budget.Purchases}" Style="{StaticResource TextH2}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding FilteredTotal}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="20,0,20,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
              <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc Budget.Search}" AutomationProperties.Name="Search" />
              <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" DisplayMemberPath="Label" />
              <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding CategoryFilter}" DisplayMemberPath="Label" />
            </Grid>
            <Grid>
              <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="8,0,8,8" MaxHeight="520" AutomationProperties.Name="Purchases">
                <DataGrid.InputBindings>
                  <KeyBinding Key="Return" Command="{Binding EditCommand}" CommandParameter="{Binding Selected}" />
                  <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}" />
                </DataGrid.InputBindings>
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    <Setter Property="ContextMenu">
                      <Setter.Value>
                        <ContextMenu>
                          <MenuItem Header="{loc:Loc Common.Edit}" Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                          <MenuItem Header="{loc:Loc Common.Delete}" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        </ContextMenu>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{loc:Loc Budget.Column.Product}" Width="2*" MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Product}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Category}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{loc:Loc Budget.Column.Unit}" Binding="{Binding UnitPrice}" Width="95" ElementStyle="{StaticResource GridText}" />
                  <DataGridTextColumn Header="{loc:Loc Budget.Column.Qty}" Binding="{Binding Quantity}" Width="50" ElementStyle="{StaticResource GridText}" />
                  <DataGridTextColumn Header="{loc:Loc Budget.Column.Total}" Binding="{Binding Total}" Width="100" ElementStyle="{StaticResource GridText}" />
                  <DataGridTextColumn Header="{loc:Loc Common.Date}" Binding="{Binding Date}" Width="100" ElementStyle="{StaticResource GridText}" />
                  <DataGridTemplateColumn Header="{loc:Loc Budget.Column.Status}" Width="110">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ctl:StatusBadge Text="{Binding Status}" Tone="{Binding Tone}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" Margin="0,30" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:Loc Budget.Empty}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Loc Budget.Empty.Hint}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="{loc:Loc Budget.ByCategory}" Style="{StaticResource TextH2}" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,14">
                    <Grid>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,90,0" />
                      <TextBlock Text="{Binding Spent}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Margin="0,6,0,4">
                      <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                          <Style.Triggers><DataTrigger Binding="{Binding Over}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers>
                        </Style>
                      </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Style="{StaticResource TextCaption}"><Run Text="{loc:Loc Budget.Planned}" /><Run Text=": " /><Run Text="{Binding Planned, Mode=OneWay}" /><Run Text="  /  " /><Run Text="{loc:Loc Budget.Allocation}" /><Run Text=": " /><Run Text="{Binding Allocation, Mode=OneWay}" /></TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
