<UserControl x:Class="FTC.TeamDesk.UI.Views.Pages.TeamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FTC.TeamDesk.UI.Localization"
             xmlns:ctl="clr-namespace:FTC.TeamDesk.UI.Controls"
             xmlns:h="clr-namespace:FTC.TeamDesk.UI.Helpers"
             xmlns:ui="clr-namespace:FTC.TeamDesk.UI">
  <Grid Margin="32,28,32,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="{loc:Loc Nav.Team}" Style="{StaticResource TextTitle}" />
        <TextBlock Text="{Binding CountText}" Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Command="{Binding ManageStatusesCommand}" Content="{loc:Loc Team.ManageStatuses}" />
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Content="{loc:Loc Team.New}" Margin="8,0,0,0" ToolTip="Ctrl+N" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search" ToolTip="{loc:Loc Team.Search}" />
      <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" DisplayMemberPath="Label" />
      <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding AreaOptions}" SelectedItem="{Binding AreaFilter}" DisplayMemberPath="Label" />
      <Button Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding ClearFiltersCommand}" Content="{loc:Loc Common.ClearFilters}" />
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0">
      <Grid>
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="8,4" AutomationProperties.Name="Members">
          <DataGrid.InputBindings>
            <KeyBinding Key="Return" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" />
            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}" />
          </DataGrid.InputBindings>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
              <Setter Property="ContextMenu">
                <Setter.Value>
                  <ContextMenu>
                    <MenuItem Header="{loc:Loc Team.Open}" Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                    <MenuItem Header="{loc:Loc Common.Edit}" Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                    <MenuItem Header="{loc:Loc Common.Delete}" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                  </ContextMenu>
                </Setter.Value>
              </Setter>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{loc:Loc Team.Column.Name}" Width="2*" MinWidth="200">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <ctl:Avatar Initials="{Binding Initials}" Tone="{Binding Tone}" ImagePath="{Binding AvatarPath}" Diameter="30" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Email}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{loc:Loc Team.Column.Status}" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusName}" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{loc:Loc Team.Column.Areas}" Binding="{Binding Areas}" Width="1.5*" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Team.Column.Skills}" Binding="{Binding Skills}" Width="1.5*" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Team.Column.Joined}" Binding="{Binding Joined}" Width="110" ElementStyle="{StaticResource GridText}" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="&#xE716;" Style="{StaticResource IconText}" FontSize="36" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{loc:Loc Team.Empty}" Margin="0,10,0,4" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Loc Team.Empty.Hint}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
