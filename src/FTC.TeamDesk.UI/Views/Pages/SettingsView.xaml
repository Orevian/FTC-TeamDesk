<UserControl x:Class="FTC.TeamDesk.UI.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FTC.TeamDesk.UI.Localization"
             xmlns:ctl="clr-namespace:FTC.TeamDesk.UI.Controls"
             xmlns:h="clr-namespace:FTC.TeamDesk.UI.Helpers"
             xmlns:ui="clr-namespace:FTC.TeamDesk.UI"
             xmlns:enums="clr-namespace:FTC.TeamDesk.Core.Enums;assembly=FTC.TeamDesk.Core">
  <Grid Margin="32,28,32,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock Text="{loc:Loc Nav.Settings}" Style="{StaticResource TextTitle}" Margin="0,0,0,16" />
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding Tabs}" SelectedValuePath="Value" SelectedValue="{Binding Tab, Mode=TwoWay}" DisplayMemberPath="Label" AutomationProperties.Name="Settings sections" />

      <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
        <Grid>
          <!-- General -->
          <ScrollViewer Style="{StaticResource PageScroll}" Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="28" DataContext="{Binding General}">
              <TextBlock Text="{loc:Loc Settings.General}" Style="{StaticResource TextH2}" Margin="0,0,0,20" />
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Language}" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Settings.Language.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,16,0" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Label" AutomationProperties.Name="Language" /></ContentControl>
          </Grid>
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Theme}" FontWeight="SemiBold" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" DisplayMemberPath="Label" AutomationProperties.Name="Theme" /></ContentControl>
          </Grid>
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Startup}" FontWeight="SemiBold" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><ComboBox ItemsSource="{Binding Startups}" SelectedItem="{Binding Startup}" DisplayMemberPath="Label" AutomationProperties.Name="Startup page" /></ContentControl>
          </Grid>
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Notifications}" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Settings.Notifications.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,16,0" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding Notifications}" HorizontalAlignment="Left" AutomationProperties.Name="Notifications" /></ContentControl>
          </Grid>
            </StackPanel>
          </ScrollViewer>

          <!-- AI -->
          <ScrollViewer Style="{StaticResource PageScroll}" Visibility="{Binding IsAi, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="28" DataContext="{Binding Ai}">
              <TextBlock Text="{loc:Loc Settings.Ai}" Style="{StaticResource TextH2}" Margin="0,0,0,6" />
              <TextBlock Text="{loc:Loc Settings.Ai.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,20" />
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Ai.Enabled}" FontWeight="SemiBold" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding IsEnabled}" HorizontalAlignment="Left" AutomationProperties.Name="Enable assistant" /></ContentControl>
          </Grid>
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Ai.Provider}" FontWeight="SemiBold" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" DisplayMemberPath="Label" AutomationProperties.Name="Provider" /></ContentControl>
          </Grid>
              <Grid Visibility="{Binding UsesBaseUrl, Converter={StaticResource BoolToVis}}">
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Ai.BaseUrl}" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Settings.Ai.BaseUrl.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,16,0" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding BaseUrlPlaceholder}" /></ContentControl>
          </Grid></Grid>
              <Grid Visibility="{Binding NeedsApiKey, Converter={StaticResource BoolToVis}}">
                
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Ai.ApiKey}" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Settings.Ai.ApiKey.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,16,0" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><StackPanel><PasswordBox h:PasswordBoxHelper.BoundPassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="API key" /><Grid Margin="0,6,0,0"><TextBlock Style="{StaticResource TextCaption}" Text="{loc:Loc Settings.Ai.KeySaved}" Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Command="{Binding ClearKeyCommand}" Content="{loc:Loc Settings.Ai.ClearKey}" Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}}" /></Grid></StackPanel></ContentControl>
          </Grid>
              </Grid>
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Ai.Model}" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Settings.Ai.Model.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,16,0" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox IsEditable="True" ItemsSource="{Binding ModelChoices}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Model" /><Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" Content="&#xE72C;" Command="{Binding LoadModelsCommand}" ToolTip="{loc:Loc Settings.Ai.LoadModels}" AutomationProperties.Name="Load models" /></Grid></ContentControl>
          </Grid>
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Ai.Temperature}" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Settings.Ai.Temperature.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,16,0" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBox Text="{Binding Temperature, UpdateSourceTrigger=LostFocus}" /></ContentControl>
          </Grid>
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Ai.MaxTokens}" FontWeight="SemiBold" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBox Text="{Binding MaxTokens, UpdateSourceTrigger=LostFocus}" /></ContentControl>
          </Grid>
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource TextSecondaryBrush}" />
              <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding SaveCommand}" Content="{loc:Loc Common.Save}" />

              <Border Style="{StaticResource Divider}" Margin="0,28" />
              <TextBlock Text="{loc:Loc Settings.Ai.Permissions}" Style="{StaticResource TextH2}" />
              <TextBlock Text="{loc:Loc Settings.Ai.Permissions.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,4,0,16" />
              <TextBlock Text="{loc:Loc Settings.Ai.Permissions.Read}" Style="{StaticResource TextLabel}" />
              <ItemsControl ItemsSource="{Binding ReadPermissions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,12,0" AutomationProperties.Name="{Binding Label}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="{loc:Loc Settings.Ai.Permissions.Write}" Style="{StaticResource TextLabel}" Margin="0,10,0,0" />
              <ItemsControl ItemsSource="{Binding WritePermissions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,12,0" AutomationProperties.Name="{Binding Label}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate></ItemsControl>
              <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Padding="16,14" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="{loc:Loc Settings.Ai.Permissions.Vault}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                  <TextBlock Text="{loc:Loc Settings.Ai.Permissions.Vault.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,4,0,10" />
                  <ContentControl Content="{Binding VaultPermission}">
                    <ContentControl.ContentTemplate>
                      <DataTemplate>
                        <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding Label}" />
                      </DataTemplate>
                    </ContentControl.ContentTemplate>
                  </ContentControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Google -->
          <ScrollViewer Style="{StaticResource PageScroll}" Visibility="{Binding IsGoogle, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="28" DataContext="{Binding Google}">
              <TextBlock Text="{loc:Loc Settings.Google}" Style="{StaticResource TextH2}" Margin="0,0,0,6" />
              <TextBlock Text="{loc:Loc Settings.Google.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,18" />
              <Border Background="{DynamicResource HoverBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                  <TextBlock Text="{loc:Loc Settings.Google.Status}" Style="{StaticResource TextCaption}" Margin="0,0,20,6" />
                  <ctl:StatusBadge Grid.Column="1" Text="{Binding StateText}" Tone="{Binding StateTone}" />
                  <TextBlock Grid.Row="1" Text="{loc:Loc Settings.Google.Account}" Style="{StaticResource TextCaption}" Margin="0,0,20,6" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Account}" />
                  <TextBlock Grid.Row="2" Text="{loc:Loc Settings.Google.Sheet}" Style="{StaticResource TextCaption}" Margin="0,0,20,6" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentSheet}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="3" Text="{loc:Loc Settings.Google.LastSync}" Style="{StaticResource TextCaption}" Margin="0,0,20,0" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastSync}" />
                </Grid>
              </Border>

              <StackPanel Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}">
                
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Google.ClientId}" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Settings.Google.ClientId.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,16,0" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Client ID" /></ContentControl>
          </Grid>
                
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Google.ClientSecret}" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Settings.Google.ClientSecret.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,16,0" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><PasswordBox h:PasswordBoxHelper.BoundPassword="{Binding ClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Client secret" /></ContentControl>
          </Grid>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding ConnectCommand}" Content="{loc:Loc Settings.Google.Connect}" />
              </StackPanel>

              <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:Loc Settings.Google.PickSheet}" Style="{StaticResource TextLabel}" />
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding Sheet}" AutomationProperties.Name="Spreadsheet" />
                  <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ListSheetsCommand}" Content="{loc:Loc Settings.Google.LoadSheets}" />
                </Grid>
                <TextBlock Text="{loc:Loc Settings.Google.Tab}" Style="{StaticResource TextLabel}" />
                <ComboBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding Tab}" Margin="0,0,0,12" AutomationProperties.Name="Sheet tab" />
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource PrimaryButton}" Command="{Binding SelectCommand}" Content="{loc:Loc Settings.Google.UseSheet}" />
                  <Button Command="{Binding TestCommand}" Content="{loc:Loc Settings.Google.Test}" Margin="8,0,0,0" />
                  <Button Command="{Binding DisconnectCommand}" Content="{loc:Loc Settings.Google.Disconnect}" Margin="8,0,0,0" />
                </StackPanel>
              </StackPanel>

              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding MessageIsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </ScrollViewer>

          <!-- Security -->
          <ScrollViewer Style="{StaticResource PageScroll}" Visibility="{Binding IsSecurity, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="28" DataContext="{Binding Security}">
              <TextBlock Text="{loc:Loc Settings.Security}" Style="{StaticResource TextH2}" Margin="0,0,0,20" />
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Security.AutoLock}" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Settings.Security.AutoLock.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,16,0" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><ComboBox ItemsSource="{Binding AutoLockChoices}" SelectedItem="{Binding AutoLockMinutes}" AutomationProperties.Name="Auto-lock minutes" /></ContentControl>
          </Grid>
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Security.Clipboard}" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Settings.Security.Clipboard.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,16,0" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><ComboBox ItemsSource="{Binding ClipboardChoices}" SelectedItem="{Binding ClipboardSeconds}" AutomationProperties.Name="Clipboard seconds" /></ContentControl>
          </Grid>
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Security.LockMinimize}" FontWeight="SemiBold" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding LockOnMinimize}" HorizontalAlignment="Left" AutomationProperties.Name="Lock on minimize" /></ContentControl>
          </Grid>
              
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc Settings.Security.LockSession}" FontWeight="SemiBold" /></StackPanel>
            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding LockOnSession}" HorizontalAlignment="Left" AutomationProperties.Name="Lock on session lock" /></ContentControl>
          </Grid>
            </StackPanel>
          </ScrollViewer>

          <!-- Data -->
          <ScrollViewer Style="{StaticResource PageScroll}" Visibility="{Binding IsData, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="28" DataContext="{Binding Data}">
              <TextBlock Text="{loc:Loc Settings.Data}" Style="{StaticResource TextH2}" Margin="0,0,0,6" />
              <TextBlock Text="{loc:Loc Settings.Data.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,18" />
              <TextBlock Text="{loc:Loc Settings.Data.Location}" Style="{StaticResource TextLabel}" />
              <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,18" />
              <WrapPanel>
                <Button Command="{Binding BackupCommand}" Content="{loc:Loc Settings.Data.Backup}" Margin="0,0,8,8" />
                <Button Command="{Binding RestoreCommand}" Content="{loc:Loc Settings.Data.Restore}" Margin="0,0,8,8" />
                <Button Command="{Binding ExportCommand}" Content="{loc:Loc Settings.Data.Export}" Margin="0,0,8,8" />
                <Button Command="{Binding ImportCommand}" Content="{loc:Loc Settings.Data.Import}" Margin="0,0,8,8" />
                <Button Command="{Binding OpenFolderCommand}" Content="{loc:Loc Settings.Data.OpenFolder}" Margin="0,0,8,8" />
                <Button Command="{Binding ActivityLogCommand}" Content="{loc:Loc Settings.ActivityLog}" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="{loc:Loc Settings.Data.VaultNote}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
              <Border Style="{StaticResource Divider}" Margin="0,24" />
              <TextBlock Text="{loc:Loc Settings.Data.Demo}" Style="{StaticResource TextLabel}" />
              <TextBlock Text="{loc:Loc Settings.Data.Demo.Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <Button HorizontalAlignment="Left" Command="{Binding SeedCommand}" Content="{loc:Loc Settings.Data.Demo}" />
            </StackPanel>
          </ScrollViewer>

          <!-- About -->
          <ScrollViewer Style="{StaticResource PageScroll}" Visibility="{Binding IsAbout, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="28" DataContext="{Binding About}">
              <TextBlock Text="FTC TeamDesk" Style="{StaticResource TextTitle}" />
              <TextBlock Style="{StaticResource TextSecondary}" Margin="0,4,0,20"><Run Text="{loc:Loc Settings.About.Version}" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
              <TextBlock Text="{loc:Loc Settings.About.Description}" TextWrapping="Wrap" Margin="0,0,0,16" />
              <TextBlock Text="{loc:Loc Settings.About.Runtime}" Style="{StaticResource TextLabel}" /><TextBlock Text="{Binding Runtime}" Margin="0,0,0,12" />
              <TextBlock Text="{loc:Loc Settings.About.License}" Style="{StaticResource TextLabel}" /><TextBlock Text="MIT" Margin="0,0,0,12" />
              <TextBlock Text="{loc:Loc Settings.Data.Location}" Style="{StaticResource TextLabel}" /><TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap" />
              <TextBlock Text="{loc:Loc Settings.About.Independent}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,24,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
