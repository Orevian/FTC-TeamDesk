<UserControl x:Class="FTC.TeamDesk.UI.Views.Pages.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FTC.TeamDesk.UI.Localization"
             xmlns:ctl="clr-namespace:FTC.TeamDesk.UI.Controls"
             xmlns:h="clr-namespace:FTC.TeamDesk.UI.Helpers"
             xmlns:ui="clr-namespace:FTC.TeamDesk.UI"
             xmlns:enums="clr-namespace:FTC.TeamDesk.Core.Enums;assembly=FTC.TeamDesk.Core">
  <Grid Margin="32,28,32,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="{loc:Loc Nav.Assistant}" Style="{StaticResource TextTitle}" />
        <TextBlock Text="{loc:Loc Assistant.Subtitle}" Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
      </StackPanel>
      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ClearCommand}" Content="{loc:Loc Assistant.Clear}" />
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0">
      <Grid>
        <!-- Not configured / disabled -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="&#xE8BD;" Style="{StaticResource IconText}" FontSize="34" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{Binding UnavailableText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,14" />
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenSettingsCommand}" Content="{loc:Loc Assistant.OpenSettings}" HorizontalAlignment="Center" />
        </StackPanel>

        <Grid Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{loc:Loc Assistant.Welcome}" Style="{StaticResource TextH2}" FontSize="18" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Loc Assistant.Welcome.Hint}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,18" />
            <ItemsControl ItemsSource="{Binding Suggestions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,0,0,8" HorizontalContentAlignment="Left" Command="{Binding DataContext.SuggestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Converter={StaticResource KeyToText}}" TextWrapping="Wrap" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <ItemsControl ItemsSource="{Binding Messages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="Bubble" Margin="0,0,0,12" Padding="14,10" CornerRadius="10" MaxWidth="640" HorizontalAlignment="Left" Background="{DynamicResource HoverBrush}">
                    <StackPanel>
                      <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Tools}" Style="{StaticResource TextCaption}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding HasTools, Converter={StaticResource BoolToVis}}" />
                      <TextBlock Text="{Binding Time}" Style="{StaticResource TextCaption}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="User"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentSoftBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Side}" Value="Error"><Setter TargetName="Bubble" Property="Background" Value="{DynamicResource DangerSoftBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Side}" Value="System"><Setter TargetName="Bubble" Property="Background" Value="Transparent" /><Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter TargetName="Bubble" Property="BorderThickness" Value="1" /></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,0" IsEnabled="{Binding IsReady}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="InputBox" Style="{StaticResource MultiLineBox}" MinHeight="44" MaxHeight="140" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Message" ToolTip="{loc:Loc Assistant.InputHint}" PreviewKeyDown="OnInputKeyDown">
      </TextBox>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
        <Button Command="{Binding CancelCommand}" Content="{loc:Loc Common.Cancel}" Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" MinHeight="44" />
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" Content="{loc:Loc Assistant.Send}" MinHeight="44" Padding="20,0" />
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" Text="{loc:Loc Assistant.Thinking}" Style="{StaticResource TextCaption}" VerticalAlignment="Top" Margin="0,-18,0,0" Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}" />
  </Grid>
</UserControl>
