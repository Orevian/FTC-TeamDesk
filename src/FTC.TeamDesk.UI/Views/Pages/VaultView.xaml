<UserControl x:Class="FTC.TeamDesk.UI.Views.Pages.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FTC.TeamDesk.UI.Localization"
             xmlns:ctl="clr-namespace:FTC.TeamDesk.UI.Controls"
             xmlns:h="clr-namespace:FTC.TeamDesk.UI.Helpers"
             xmlns:ui="clr-namespace:FTC.TeamDesk.UI"
             xmlns:enums="clr-namespace:FTC.TeamDesk.Core.Enums;assembly=FTC.TeamDesk.Core">
  <Grid>
    <!-- Create master password -->
    <Grid Visibility="{Binding IsCreate, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource Panel}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
        <StackPanel>
          <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="30" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" />
          <TextBlock Text="{loc:Loc Vault.Create.Title}" Style="{StaticResource TextTitle}" FontSize="20" Margin="0,12,0,4" />
          <TextBlock Text="{loc:Loc Vault.Create.Hint}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,18" />
          <TextBlock Text="{loc:Loc Vault.MasterPassword}" Style="{StaticResource TextLabel}" />
          <PasswordBox h:PasswordBoxHelper.BoundPassword="{Binding MasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Master password" />
          <Grid Margin="0,8,0,0">
            <ProgressBar Style="{StaticResource StrengthBar}" Value="{Binding StrengthScore, Mode=OneWay}" Maximum="4" />
          </Grid>
          <TextBlock Text="{Binding StrengthText}" Style="{StaticResource TextCaption}" Margin="0,4,0,12" />
          <TextBlock Text="{loc:Loc Vault.ConfirmPassword}" Style="{StaticResource TextLabel}" />
          <PasswordBox h:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Confirm master password" />
          <TextBlock Text="{Binding Message}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{loc:Loc Vault.Create.Warning}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,12,0,16" />
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" Content="{loc:Loc Vault.Create}" IsDefault="True" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Locked -->
    <Grid Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource Panel}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
        <StackPanel>
          <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="30" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" />
          <TextBlock Text="{loc:Loc Vault.Locked.Title}" Style="{StaticResource TextTitle}" FontSize="20" Margin="0,12,0,4" />
          <TextBlock Text="{loc:Loc Vault.Locked.Hint}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,18" />
          <TextBlock Text="{loc:Loc Vault.MasterPassword}" Style="{StaticResource TextLabel}" />
          <PasswordBox h:PasswordBoxHelper.BoundPassword="{Binding MasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Master password" />
          <TextBlock Text="{Binding Message}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding UnlockCommand}" Content="{loc:Loc Vault.Unlock}" IsDefault="True" Margin="0,16,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Unlocked -->
    <Grid Margin="32,28,32,24" Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{loc:Loc Nav.Vault}" Style="{StaticResource TextTitle}" />
          <TextBlock Text="{loc:Loc Vault.Unlocked.Hint}" Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Command="{Binding ChangeMasterCommand}" Content="{loc:Loc Vault.ChangeMaster}" />
          <Button Command="{Binding LockCommand}" Content="{loc:Loc Vault.Lock}" Margin="8,0,0,0" ToolTip="Ctrl+L" />
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Content="{loc:Loc Vault.New}" Margin="8,0,0,0" ToolTip="Ctrl+N" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="280" /><ColumnDefinition Width="16" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Panel}" Padding="12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc Vault.Search}" AutomationProperties.Name="Search vault" Margin="0,0,0,8" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="Vault entries">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Category, Mode=OneWay}" /><Run Text="  •  " /><Run Text="{Binding Username, Mode=OneWay}" /></TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" Text="{loc:Loc Vault.Empty}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="28">
          <Grid>
            <TextBlock Text="{loc:Loc Vault.SelectHint}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}" />
            <ScrollViewer Style="{StaticResource PageScroll}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource TextH2}" FontSize="20" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailCategory}" Style="{StaticResource TextCaption}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Command="{Binding EditCommand}" ToolTip="{loc:Loc Common.Edit}" AutomationProperties.Name="Edit" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding DeleteCommand}" ToolTip="{loc:Loc Common.Delete}" AutomationProperties.Name="Delete" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Loc Vault.Field.Username}" Style="{StaticResource TextLabel}" Margin="0,20,0,4" />
                <Grid>
                  <TextBlock Text="{Binding DetailUsername}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,44,0" />
                  <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" HorizontalAlignment="Right" ToolTip="{loc:Loc Common.Copy}" AutomationProperties.Name="Copy username"
                          Command="{Binding CopyTextCommand}" CommandParameter="{Binding DetailUsername}" />
                </Grid>

                <TextBlock Text="{loc:Loc Vault.Field.Password}" Style="{StaticResource TextLabel}" Margin="0,16,0,4" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding PasswordText}" FontFamily="{StaticResource MonoFont}" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding RevealCommand}" ToolTip="{loc:Loc Vault.Reveal}" AutomationProperties.Name="Show or hide password">
                    <TextBlock FontSize="15"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource IconText}"><Setter Property="Text" Value="&#xE7B3;" /><Style.Triggers><DataTrigger Binding="{Binding IsRevealed}" Value="True"><Setter Property="Text" Value="&#xED1A;" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                  </Button>
                  <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8C8;" Command="{Binding CopyPasswordCommand}" ToolTip="{loc:Loc Vault.CopyPassword}" AutomationProperties.Name="Copy password" />
                </Grid>

                <TextBlock Text="{loc:Loc Vault.Field.Url}" Style="{StaticResource TextLabel}" Margin="0,16,0,4" />
                <Grid>
                  <TextBlock Text="{Binding DetailUrl}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,44,0" />
                  <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" HorizontalAlignment="Right" ToolTip="{loc:Loc Common.Copy}" AutomationProperties.Name="Copy URL"
                          Command="{Binding CopyTextCommand}" CommandParameter="{Binding DetailUrl}" />
                </Grid>

                <TextBlock Text="{loc:Loc Vault.Field.Notes}" Style="{StaticResource TextLabel}" Margin="0,16,0,4" />
                <TextBlock Text="{Binding DetailNotes}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource TextCaption}" Margin="0,20,0,0"><Run Text="{loc:Loc Vault.Updated}" /><Run Text=": " /><Run Text="{Binding DetailUpdated, Mode=OneWay}" /></TextBlock>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
