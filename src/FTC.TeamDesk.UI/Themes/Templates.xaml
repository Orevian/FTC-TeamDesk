<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:FTC.TeamDesk.UI.Views.Pages"
                    xmlns:dash="clr-namespace:FTC.TeamDesk.UI.ViewModels.Dashboard"
                    xmlns:team="clr-namespace:FTC.TeamDesk.UI.ViewModels.Team"
                    xmlns:apps="clr-namespace:FTC.TeamDesk.UI.ViewModels.Applications"
                    xmlns:bud="clr-namespace:FTC.TeamDesk.UI.ViewModels.Budget"
                    xmlns:ana="clr-namespace:FTC.TeamDesk.UI.ViewModels.Analytics"
                    xmlns:vlt="clr-namespace:FTC.TeamDesk.UI.ViewModels.Vault"
                    xmlns:ast="clr-namespace:FTC.TeamDesk.UI.ViewModels.Assistant"
                    xmlns:set="clr-namespace:FTC.TeamDesk.UI.ViewModels.Settings">
  <!-- View model -> view mapping: the shell just shows the current page view model in a ContentControl. -->
  <DataTemplate DataType="{x:Type dash:DashboardViewModel}"><pages:DashboardView /></DataTemplate>
  <DataTemplate DataType="{x:Type team:TeamViewModel}"><pages:TeamView /></DataTemplate>
  <DataTemplate DataType="{x:Type team:MemberDetailViewModel}"><pages:MemberDetailView /></DataTemplate>
  <DataTemplate DataType="{x:Type apps:ApplicationsViewModel}"><pages:ApplicationsView /></DataTemplate>
  <DataTemplate DataType="{x:Type bud:BudgetViewModel}"><pages:BudgetView /></DataTemplate>
  <DataTemplate DataType="{x:Type ana:AnalyticsViewModel}"><pages:AnalyticsView /></DataTemplate>
  <DataTemplate DataType="{x:Type vlt:VaultViewModel}"><pages:VaultView /></DataTemplate>
  <DataTemplate DataType="{x:Type ast:AssistantViewModel}"><pages:AssistantView /></DataTemplate>
  <DataTemplate DataType="{x:Type set:SettingsViewModel}"><pages:SettingsView /></DataTemplate>
</ResourceDictionary>
