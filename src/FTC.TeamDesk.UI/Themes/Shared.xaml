<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cv="clr-namespace:FTC.TeamDesk.UI.Converters"
                    xmlns:ctl="clr-namespace:FTC.TeamDesk.UI.Controls"
                    xmlns:ui="clr-namespace:FTC.TeamDesk.UI"
                    xmlns:dash="clr-namespace:FTC.TeamDesk.UI.ViewModels.Dashboard">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Base.xaml" />
  </ResourceDictionary.MergedDictionaries>


  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <cv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
  <cv:InverseBoolConverter x:Key="InvBool" />
  <cv:NullToVisibilityConverter x:Key="NullToVis" />
  <cv:HexToBrushConverter x:Key="HexToBrush" />
  <cv:AvatarBrushConverter x:Key="AvatarBrush" />
  <cv:PercentConverter x:Key="Percent" />
  <cv:BoolToBrushConverter x:Key="BoolToBrush" />
  <cv:LocKeyConverter x:Key="KeyToText" />
  <cv:InitialsConverter x:Key="InitialsOf" />

  <!-- A one-line list row: title/subtitle on the left, optional status badge and trailing value on the right. -->
  <DataTemplate x:Key="ListRowTemplate" DataType="{x:Type dash:ListRow}">
    <Grid Margin="0,0" MinHeight="46">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,6">
        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis"
                   Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock Text="{Binding Trailing}" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding Trailing, Converter={StaticResource NullToVis}}" />
        <ctl:StatusBadge Text="{Binding Badge}" Tone="{Binding Tone}" VerticalAlignment="Center" Visibility="{Binding Badge, Converter={StaticResource NullToVis}}" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- Legend row for charts: swatch, label, value. -->
  <DataTemplate x:Key="LegendTemplate" DataType="{x:Type ui:ChartDatum}">
    <Grid Margin="0,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ctl:ChartSwatch ColorIndex="{Binding ColorIndex}" />
      <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="2" Text="{Binding Text}" FontWeight="SemiBold" />
    </Grid>
  </DataTemplate>

  <Style x:Key="PageScroll" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Field label above an input inside forms. -->
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TextLabel}" />

  <!-- Strength meter track -->
  <Style x:Key="StrengthBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Maximum" Value="100" />
  </Style>
</ResourceDictionary>
