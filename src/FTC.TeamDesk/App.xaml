<Application x:Class="FTC.TeamDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Index 0 MUST be the color dictionary: ThemeService swaps it at runtime for light/dark. -->
        <ResourceDictionary Source="pack://application:,,,/FTC.TeamDesk.UI;component/Themes/Colors.Light.xaml" />
        <ResourceDictionary Source="pack://application:,,,/FTC.TeamDesk.UI;component/Themes/Base.xaml" />
        <ResourceDictionary Source="pack://application:,,,/FTC.TeamDesk.UI;component/Themes/Controls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/FTC.TeamDesk.UI;component/Themes/Shared.xaml" />
        <ResourceDictionary Source="pack://application:,,,/FTC.TeamDesk.UI;component/Themes/Dialogs.xaml" />
        <ResourceDictionary Source="pack://application:,,,/FTC.TeamDesk.UI;component/Themes/Templates.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
